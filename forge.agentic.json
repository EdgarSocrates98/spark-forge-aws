{
  "schema": "forge/SpecialistAgenticManifest/v1",
  "provider": "spark-forge-aws",
  "version": "0.7.6",
  "cli": "sparkforge-aws",
  "cli_entry": "sparkforge_aws.adapters.cli:main",
  "workflows": [
    {
      "id": "analyze-pyspark",
      "mode": "DIRECT_CAPABILITY",
      "command": [
        "{cli}",
        "analyze",
        "pyspark",
        "--path",
        "{target}"
      ],
      "description": "Static AST analysis of PySpark sources",
      "read_only": true
    },
    {
      "id": "doctor",
      "mode": "DIAGNOSTIC_ONLY",
      "command": [
        "{cli}",
        "doctor"
      ],
      "description": "Environment + installation health",
      "read_only": true
    },
    {
      "id": "playbook",
      "mode": "SPECIALIST_WORKFLOW",
      "command": [
        "{cli}",
        "playbook",
        "spark-performance-architect",
        "--repo",
        "{target}"
      ],
      "description": "Coordinator decomposition playbook",
      "read_only": true
    }
  ],
  "skills": [
    "spark-performance-architect"
  ],
  "agents": [
    "athena-query-optimizer",
    "cdc-contract-reviewer",
    "data-quality-reviewer",
    "emr-infra-reviewer",
    "glue-incremental-performance-architect",
    "glue-infra-reviewer",
    "iceberg-performance-engineer",
    "pyspark-code-reviewer",
    "sf-lake-formation-specialist",
    "sf-runtime-specialist",
    "sf-security-reviewer",
    "sf-terraform-specialist",
    "streaming-realtime-architect"
  ],
  "coordinators": [
    "spark-performance-architect"
  ],
  "mcp_command": [
    "{cli}",
    "mcp",
    "serve"
  ],
  "host_adapters": [
    "claude",
    "devin",
    "codex",
    "copilot"
  ],
  "requires_network": false,
  "requires_credentials": false,
  "read_only_default": true
}
