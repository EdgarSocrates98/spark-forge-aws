{
  "mcpServers": {
    "sparkforge-aws": {
      "command": "python",
      "args": ["-m", "sparkforge_aws.adapters.mcp", "--transport", "stdio"],
      "env": {
        "PYTHONPATH": "${CLAUDE_PLUGIN_ROOT}",
        "SPARKFORGE_AWS_CATALOG": "${CLAUDE_PLUGIN_ROOT}/rules/catalog"
      }
    }
  }
}
