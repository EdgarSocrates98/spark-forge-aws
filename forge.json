{
  "forge_id": "spark-forge-aws",
  "package": "sparkforge_aws",
  "distribution": "sparkforge-aws",
  "cli": "sparkforge-aws",
  "python": ">=3.10",
  "mcp_server_name": "sparkforge-aws",
  "mcp_command": [
    "sparkforge-aws",
    "mcp",
    "serve"
  ],
  "mcp_verify_tool": "sparkforge_aws_runtime_detect",
  "installation_kind": "content",
  "install": {
    "operations": [
      "plan",
      "apply",
      "status",
      "doctor",
      "repair",
      "update",
      "uninstall",
      "mcp-verify"
    ],
    "flags": [
      "--scope",
      "--root",
      "--host",
      "--profile",
      "--components",
      "--gateway-profile",
      "--yes",
      "--dry-run",
      "--purge",
      "--to",
      "--repo"
    ],
    "hosts": [
      "claude",
      "devin",
      "codex",
      "copilot"
    ],
    "scopes": [
      "project",
      "workspace",
      "user"
    ],
    "profiles": [
      "minimal",
      "recommended",
      "full"
    ],
    "approval": "--yes"
  },
  "depends_on": [],
  "extras": [
    "mcp"
  ],
  "lab": {
    "extras": [],
    "command": [
      "{python}",
      "scripts/lab/sparkforge_aws_lab.py",
      "--checkout",
      "{checkout}",
      "--mode",
      "{mode}",
      "--result-out",
      "{receipt}"
    ],
    "receipt": ".forge/lab-result.json",
    "modes": [
      "A"
    ],
    "suite": "spark-forge-aws-lab",
    "timeout_s": 120
  }
}
