{
  "forge_id": "spark-forge-aws",
  "package": "sparkforge_aws",
  "distribution": "sparkforge-aws",
  "cli": "sparkforge-aws",
  "python": ">=3.10",
  "mcp_server_name": "sparkforge-aws",
  "mcp_command": [
    "sparkforge-aws",
    "mcp",
    "serve"
  ],
  "extras": [
    "mcp"
  ],
  "lab": {
    "command": [
      "{checkout}/.venv/bin/python",
      "scripts/lab/sparkforge_aws_lab.py",
      "--checkout",
      "{checkout}",
      "--mode",
      "{mode}",
      "--result-out",
      "{receipt}"
    ],
    "receipt": ".forge/lab-result.json",
    "modes": [
      "A"
    ],
    "suite": "spark-forge-aws-lab",
    "timeout_s": 120
  }
}
