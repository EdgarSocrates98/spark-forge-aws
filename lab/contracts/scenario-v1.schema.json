{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sparkforge_aws.local/contracts/forge-lab-scenario-v1.schema.json",
  "title": "Forge Lab Scenario v1",
  "type": "object",
  "required": ["schema_version", "suite", "scenarios"],
  "properties": {
    "schema_version": {"const": 1},
    "suite": {"type": "string", "minLength": 1},
    "scenarios": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "slug", "version", "profile", "fidelity", "dataset", "expected", "experiment_plan"],
        "properties": {
          "id": {"type": "string"},
          "slug": {"type": "string"},
          "version": {"const": 1},
          "profile": {"type": "object"},
          "fidelity": {"type": "object"},
          "dataset": {"type": "object", "required": ["schema", "seed", "records"]},
          "expected": {"type": "object"},
          "experiment_plan": {"type": "object", "required": ["hypothesis"]}
        }
      }
    }
  }
}
