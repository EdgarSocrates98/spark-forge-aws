{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sparkforge.local/contracts/forge-lab-run-v1.schema.json",
  "title": "Forge Lab Run v1",
  "type": "object",
  "required": ["run_id", "scenario", "scenario_version", "seed", "fidelity", "status"],
  "properties": {
    "run_id": {"type": "string", "minLength": 1},
    "scenario": {"type": "string", "minLength": 1},
    "scenario_version": {"const": 1},
    "seed": {"type": "integer"},
    "status": {"enum": ["created", "PASS", "FAIL", "UNRESOLVED", "INFRA_FAILURE", "INVALID_SCENARIO"]},
    "fidelity": {"type": "object", "required": ["tier", "environment", "proves", "does_not_prove"]}
  }
}
